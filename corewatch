		fill(colors.gray, {xmin = 3, xmax = 17, ymin = height - 3, ymax = height - 1, title = "CANCEL"})
		fill(colors.red, {xmin = width - 18, xmax = width - 2, ymin = height - 3, ymax = height - 1, title = "RESET STATS"})
