local function showSessionStats()
	showingStats = true
	mon.setBackgroundColor(colors.black)
	mon.clear()
	local width, height = mon.getSize()
	local function line(y, value, color)
		mon.setCursorPos(3, y)
		mon.setTextColor(color or colors.white)
		mon.write(value)
	end

	if confirmSessionReset then
		line(2, "COREWATCH / NEW SESSION", colors.cyan)
		line(6, "Clear the session total and all per-mode stats?")
		line(8, "The reactor keeps its current mode and settings.", colors.lightGray)
		fill(colors.gray, {xmin = 3, xmax = 17, ymin = height - 3, ymax = height - 1, title = "CANCEL"})
		fill(colors.red, {xmin = width - 18, xmax = width - 2, ymin = height - 3, ymax = height - 1, title = "RESET STATS"})
		return
	end

	line(2, statsByMode and "COREWATCH / STATS BY MODE" or "COREWATCH / SESSION TOTAL", colors.cyan)
	fill(colors.blue, {xmin = width - 24, xmax = width - 13, ymin = 1, ymax = 3,
		title = statsByMode and "TOTAL" or "BY MODE"})
	fill(colors.blue, {xmin = width - 10, xmax = width - 1, ymin = 1, ymax = 3, title = "BACK"})
	line(5, "ESTIMATES SINCE COREWATCH STARTED", colors.lightGray)

	local function efficiency(totals)
		return totals.fuel > 0 and (format_num(totals.energy / totals.fuel, 0) .. " RF/mB") or "--"
	end

	local function running(totals)
		if not totals.powerSeconds or totals.powerSeconds == 0 then return "--" end
		local duty = totals.runningSeconds * 100 / totals.powerSeconds
		return format_num(totals.runningSeconds / 60, 1) .. " min on   |   Duty " .. format_num(duty, 1) .. "%"
	end

	if statsByMode then
		for i, mode in ipairs(modeOptions) do
			local y = 7 + (i - 1) * 4
			local totals = session.modes[mode]
			line(y, mode, colors.cyan)
			if totals then
				line(y + 1, "  " .. format_num(totals.energy, 0) .. " RF generated   |   " .. format_num(totals.fuel, 3) .. " mB burned")
				line(y + 2, "  " .. format_num(totals.seconds / 60, 1) .. " min sampled   |   Avg " .. efficiency(totals))
				line(y + 3, "  " .. running(totals))
			else
				line(y + 1, "  No samples yet", colors.lightGray)
			end
		end
	else
		line(7, "ALL MODES COMBINED", colors.cyan)
		line(10, "ENERGY GENERATED  " .. format_num(session.energy, 0) .. " RF")
		line(12, "FUEL BURNED       " .. format_num(session.fuel, 3) .. " mB")
		line(14, "AVG EFFICIENCY    " .. efficiency(session))
		line(16, "TIME SAMPLED      " .. format_num(session.seconds / 60, 1) .. " min")
		line(18, "RUNNING TIME      " .. running(session))
	end
	line(29, "Totals use periodic readings and skip link outages.", colors.lightGray)
	line(30, "Start a new session to compare a fresh run.", colors.lightGray)
	fill(colors.blue, {xmin = width - 18, xmax = width - 2, ymin = height - 3, ymax = height - 1, title = "NEW SESSION"})
end

local function sampleSession(stats)
	local now = os.clock()
	local previous = session.last
	if previous then
		local elapsed = now - previous.time
		local output = previous.mode == controlMode and stats.rfPerTick or previous.output
		local burn = previous.mode == controlMode and stats.fuelPerTick or previous.burn
		local energy = (previous.output + output) * elapsed * 10
		local fuel = (previous.burn + burn) * elapsed * 10
		local modeTotals = session.modes[previous.mode] or {energy = 0, fuel = 0, seconds = 0}
		modeTotals.energy = modeTotals.energy + energy
		modeTotals.fuel = modeTotals.fuel + fuel
		modeTotals.seconds = modeTotals.seconds + elapsed
		session.modes[previous.mode] = modeTotals
		session.energy = session.energy + energy
		session.fuel = session.fuel + fuel
		session.seconds = session.seconds + elapsed

		if previous.active ~= nil then
			local runningSeconds = previous.active and elapsed or 0
			modeTotals.runningSeconds = (modeTotals.runningSeconds or 0) + runningSeconds
			modeTotals.powerSeconds = (modeTotals.powerSeconds or 0) + elapsed
			session.runningSeconds = (session.runningSeconds or 0) + runningSeconds
			session.powerSeconds = (session.powerSeconds or 0) + elapsed
		end
	end
	session.last = {time = now, output = stats.rfPerTick, burn = stats.fuelPerTick, mode = controlMode, active = stats.active}
end

