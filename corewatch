local function requestPower(enabled)
	if enabled and controlMode == "STANDBY" then
		standbyArmed = true
		adjustRodsLevel()
	else
		if not enabled then standbyArmed = false end
		reactors[1].setActive(enabled)
	end
end

function adjustSelectedSetting(limit, number)
	if controlMode == "TARGET RF/t" and limit == "min" then
		targetOutput = math.max(50, math.min(1000000, targetOutput + number * 5))
		saveSettings()
		return
	end
	if controlMode == "MANUAL" then
		local stats = readReactor()
		local step = limit == "min" and number or number / 10
		local level = math.max(0, math.min(100, stats.rodLevel + step))
		setRodInsertion(level, stats.reactorRodsLevel)
		return
	end

	if limit == "min" then
		local candidate = minPowerRod + number
		minPowerRod = math.max(0, math.min(maxPowerRod - 1, candidate))
	else
		local candidate = maxPowerRod + number
		maxPowerRod = math.max(minPowerRod + 1, math.min(100, candidate))
	end
	saveSettings()
	adjustRodsLevel()
end

function adjustRodsLevel(sample)
	if controlMode == "MANUAL" then return end

	local allStats = sample or readReactor()
	local storedEnergy = allStats.rfTotal
	local rodPositions = allStats.reactorRodsLevel

	if controlMode == "STANDBY" then
		if not standbyArmed then return end

		local reactor = reactors[1]
		local active = reactor.getActive()
		local fillPercent = storedEnergy * 100 / rfTotalMax
		if active and fillPercent >= maxPowerRod then
			reactor.setActive(false)
		elseif active or (fillPercent <= minPowerRod and fillPercent < maxPowerRod) then
			if allStats.rodLevel ~= 0 then
				setRodInsertion(0, rodPositions)
			end
			if not active then
				reactor.setActive(true)
			end
		end
		return
	end

	if controlMode == "TARGET RF/t" then
		local reactor = reactors[1]
		if not reactor.getActive() then return end
		local level = allStats.rodLevel
		if storedEnergy >= rfTotalMax * maxPowerRod / 100 then
			if level ~= 100 then setRodInsertion(100, rodPositions) end
			return
		end
		local errorRF = allStats.rfPerTick - targetOutput
		if math.abs(errorRF) > math.max(5, targetOutput * 0.03) then
			local step = math.min(5, math.ceil(math.abs(errorRF) / targetOutput * 5))
			local nextLevel = math.max(0, math.min(100, level + (errorRF > 0 and step or -step)))
			if nextLevel ~= level then setRodInsertion(nextLevel, rodPositions) end
		end
		return
	end

	if controlMode == "LOAD MATCH" then
		local reactor = reactors[1]
		if not reactor.getActive() then return end

		local level = allStats.rodLevel
		local fillPercent = storedEnergy * 100 / rfTotalMax
		if fillPercent >= maxPowerRod then
			if level < 100 then setRodInsertion(100, rodPositions) end
		elseif estimatedExport ~= nil then
			local output = allStats.rfPerTick
			local reserveRate = fillPercent < minPowerRod and math.max(20, output * 0.05) or 0
			local demand = estimatedExport + reserveRate
			local errorRF = output - demand
			if math.abs(errorRF) > math.max(10, demand * 0.03) then
				-- Compare current generation with smoothed demand to reduce lag.
				local rfPerRodPoint = math.max(5, output / math.max(1, 100 - level))
				local step = math.max(1, math.min(8, math.floor(math.abs(errorRF) / rfPerRodPoint / 2)))
				local nextLevel = math.max(0, math.min(100, level + (errorRF > 0 and step or -step)))
				if nextLevel ~= level then setRodInsertion(nextLevel, rodPositions) end
			end
		end
		return
	end

	local lower = rfTotalMax * minPowerRod / 100
	local upper = rfTotalMax * maxPowerRod / 100
	local fraction = math.max(0, math.min(1, (storedEnergy - lower) / (upper - lower)))
	setRodInsertion(math.ceil(fraction * 100), rodPositions)
end
function setRodInsertion(insertion, currentPositions)
	local port = reactors[1]
	if VERSION ~= "EXTREME" then
		port.setAllControlRodLevels(insertion)
		return
	end

	for _, position in pairs(currentPositions) do
		if position ~= insertion then
			local requested = {}
			for rodIndex in pairs(currentPositions) do
				requested[rodIndex] = insertion
			end
			port.setControlRodsLevels(requested)
			return
		end
	end
end

local function panel(left, top, right, bottom, margin, topPadding)
	return {
		startX = left, startY = top, endX = right, endY = bottom,
		inX = left + margin + 1, inY = top + topPadding,
		width = right - left - 2 * margin - 2,
	}
end

local function frame(region, title, margin)
	boxes[#boxes + 1] = {region.startX, region.startY, region.endX, region.endY, colors.gray}
	if title then
		local x, y = region.startX + 2 * margin, region.startY
		lines[#lines + 1] = {x - margin, y, x + #title + 1, y, colors.black}
		texts[#texts + 1] = {x, y, title, colors.cyan, colors.black}
	end
end

function buildDashboard()
	local width, height = mon.getSize()
	dashboard = window.create(mon, 1, 1, width, height, false)
	dashboard.setBackgroundColor(colors.black)
	dashboard.clear()
	displayedRows = {}
	local margin = math.floor(width / 50)
	local top = margin + 1
	local leftEdge = (width - 2 * margin) * 2 / 3 - margin
	local rightStart = leftEdge + margin + 1
	local controlBottom = (height - 2 * margin) * 2 / 3 + 1

	infosSize = panel(top, top, leftEdge, height - margin, margin, margin + 1)
	controlsSize = panel(rightStart, top, width - margin, controlBottom, margin, margin)
	numbersSize = panel(rightStart, controlBottom + margin + 1, width - margin, height - margin, margin, margin)
	local sectionHeight = math.floor((infosSize.endY - top - 2 * margin - 2) / 3)
	infosSize.graphHeight = sectionHeight + 4
	infosSize.gaugeHeight = sectionHeight - 2
	infosSize.storageY = infosSize.inY + infosSize.graphHeight + 1
	infosSize.rodsY = infosSize.storageY + infosSize.gaugeHeight + 1
	controlsSize.sectionHeight = math.floor((controlBottom - top - margin - 1) / 4)

	frame(infosSize, "COREWATCH", margin)
	frame(controlsSize)
	frame(numbersSize, "FUEL", margin)

	local infoRight = math.floor(leftEdge) - 2
	setButton("INFO", "INFO", showInfo, infoRight - 9, infosSize.inY - 1, infoRight, infosSize.inY + 1, nil, nil, colors.blue)

	local x, y = controlsSize.inX, controlsSize.inY
	local right = x + controlsSize.width
	local center = x + math.floor(controlsSize.width / 2)
	local step = controlsSize.sectionHeight
	setButton("ON", "ON", requestPower, x, y, center - 1, y + 2, true, nil, colors.green)
	setButton("OFF", "OFF", requestPower, center + 2, y, right, y + 2, false, nil, colors.red)
	setButton("MODE", "MODE", showModeMenu, x, y + step + 1, right, y + step + 2, nil, nil, colors.blue)
	for i, change in ipairs({-10, 10}) do
		local row = y + step * (i + 1) + 2
		local suffix = change < 0 and "-10" or "+10"
		setButton("low" .. suffix, suffix, adjustSelectedSetting, x + 1, row, center - 2, row + 2, "min", change, colors.lightBlue)
		setButton("high" .. suffix, suffix, adjustSelectedSetting, center + 3, row, right - 1, row + 2, "max", change, colors.purple)
	end
end

function readReactor()
	local device = reactors[1]
	if VERSION == "EXTREME" then
		local energy = device.getEnergyStats()
		local fuel = device.getFuelStats()
		local rods = device.getControlRodsLevels()
		return {
			rfTotal = math.floor(energy.energyStored),
			rfPerTick = math.floor(energy.energyProducedLastTick),
			rodLevel = rods[0], reactorRodsLevel = rods,
			fuelPerTick = fuel.fuelConsumedLastTick,
			fuelAmount = fuel.fuelAmount, fuelCapacity = fuel.fuelCapacity,
			wasteAmount = fuel.wasteAmount,
		}
	end
	if VERSION == "BIGGERv2" then
		local battery = device.battery()
		return {
			rfTotal = battery.stored(), rfPerTick = math.floor(battery.producedLastTick()),
			rodLevel = math.floor(device.getControlRod(0).level()),
			fuelPerTick = device.fuelTank().burnedLastTick(),
		}
	end
	return {
		rfTotal = math.floor(device.getEnergyStored()),
		rfPerTick = math.floor(device.getEnergyProducedLastTick()),
		rodLevel = math.floor(device.getControlRodLevel(0)),
		fuelPerTick = device.getFuelConsumedLastTick(),
	}
end
-- Queue the label and the bar together so zero readings render on the first draw.
local function addReading(index, label, fraction)
	local x = math.floor(infosSize.inX)
	local y = index == 1 and infosSize.storageY or infosSize.rodsY
	local width = math.floor(infosSize.width) + 1
	local barTop = y + 1
	local barBottom = y + infosSize.gaugeHeight - 2
	local filledWidth = math.floor(width * math.max(0, math.min(1, fraction)))

	table.insert(lines, {x, y, x + width - 1, y, colors.black})
	table.insert(texts, {x, y, label, colors.white, colors.black})
	table.insert(filleds, {x, barTop, x + width - 1, barBottom, colors.gray})
	if filledWidth > 0 then
		table.insert(filleds, {x, barTop, x + filledWidth - 1, barBottom, colors.lime})
	end
end

local function addBufferMarkers()
	if controlMode == "MANUAL" then return end

	local x = math.floor(infosSize.inX)
	local span = math.floor(infosSize.width)
	local y = infosSize.storageY
	local top = y + 2
	local bottom = math.min(top + 1, y + infosSize.gaugeHeight - 1)
	local minColumn = x + math.floor(span * minPowerRod / 100 + 0.5)
	local maxColumn = x + math.floor(span * maxPowerRod / 100 + 0.5)

	if controlMode ~= "TARGET RF/t" then
		table.insert(lines, {minColumn, top, minColumn, bottom, colors.lightBlue})
	end
	table.insert(lines, {maxColumn, top, maxColumn, bottom, colors.purple})
end

local outputHistory = {}

local function addOutputHistory(rfPerTick)
	local x, y = math.floor(infosSize.inX), infosSize.inY
	local width = math.floor(infosSize.width) + 1
	local top = y + 2
	local height = infosSize.graphHeight - 2
	local pixelWidth, pixelHeight = width * 2, height * 3

	outputHistory[#outputHistory + 1] = rfPerTick
	if #outputHistory > pixelWidth then
		table.remove(outputHistory, 1)
	end

	local peak = 0
	for _, sample in ipairs(outputHistory) do
		peak = math.max(peak, sample)
	end

	table.insert(lines, {x, y, x + width - 1, y, colors.black})
	table.insert(texts, {x, y, "OUTPUT  " .. format_num(rfPerTick, 0) .. " RF/t  |  PEAK " .. format_num(peak, 0), colors.white, colors.black})
	table.insert(filleds, {x, top - 1, x + width - 1, top + height - 2, colors.gray})

	local cells = {}
	local function plot(px, py)
		local cell = math.floor(py / 3) * width + math.floor(px / 2)
		local bit = 2 ^ ((py % 3) * 2 + px % 2)
		cells[cell] = bit32.bor(cells[cell] or 0, bit)
	end

	local previousY
	for i, sample in ipairs(outputHistory) do
		local px = pixelWidth - #outputHistory + i - 1
		local py = pixelHeight - 1 - math.floor((pixelHeight - 1) * sample / math.max(1, peak))
		if previousY then
			-- Adjacent samples occupy neighboring columns. Split the vertical span between them.
			local middle = math.floor((previousY + py) / 2)
			for row = math.min(previousY, middle), math.max(previousY, middle) do
				plot(px - 1, row)
			end
			for row = math.min(middle, py), math.max(middle, py) do
				plot(px, row)
			end
		else
			plot(px, py)
		end
		previousY = py
	end

	for cell, mask in pairs(cells) do
		-- The sixth subpixel is the background, so invert the glyph when it is lit.
		local inverted = mask >= 32
		local glyph = string.char(128 + (inverted and 63 - mask or mask))
		local foreground = inverted and colors.gray or colors.lime
		local background = inverted and colors.lime or colors.gray
		table.insert(texts, {x + cell % width, top + math.floor(cell / width), glyph, foreground, background})
	end
end

local reactorName = peripheral.getName(reactors[1])
local linkLost = "Corewatch reactor link lost"

local function reactorLinkReady()
	if not peripheral.isPresent(reactorName) then
		return false
	end

	local reactor = reactors[1]
	if reactor.mbIsAssembled then
		local ok, assembled = pcall(reactor.mbIsAssembled)
		return ok and assembled == true
	end

	return true
end

local bufferSamples = {}

local function addNetFlow(storedEnergy, production)
	local now = os.clock()
	bufferSamples[#bufferSamples + 1] = {time = now, energy = storedEnergy, production = production}
	while #bufferSamples > 1 and bufferSamples[1].time < now - 10 do
		table.remove(bufferSamples, 1)
	end
	local first = bufferSamples[1]
	local label = "NET  -- RF/t"
	local outputLabel = "RF OUT --"
	local color = colors.lightGray
	if now > first.time then
		local rate = (storedEnergy - first.energy) / ((now - first.time) * 20)
		netBufferRate = rate

		local generated = 0
		for i = 2, #bufferSamples do
			local previous, sample = bufferSamples[i - 1], bufferSamples[i]
			generated = generated + (previous.production + sample.production) * (sample.time - previous.time) / 2
		end
		local exported = math.max(0, generated / (now - first.time) - rate)
		estimatedExport = exported
		outputLabel = "RF OUT ~" .. format_num(exported, 0) .. " RF/t"
		local magnitude = math.floor(math.abs(rate) + 0.5)
		local sign = ""
		if magnitude > 0 then
			sign = rate > 0 and "+" or "-"
			color = rate > 0 and colors.lime or colors.orange
		end
		label = "NET  " .. sign .. format_num(magnitude, 0) .. " RF/t"
	end

	local x = math.floor(infosSize.inX)
	local y = infosSize.storageY + 1
	table.insert(lines, {x, y, x + math.floor(infosSize.width), y, colors.black})
	table.insert(texts, {x, y, label, color, colors.black})
	local rightX = x + #label + 3
	local available = x + math.floor(infosSize.width) - rightX + 1
	if #outputLabel > available then
		outputLabel = outputLabel:gsub(" RF/t$", "")
	end
	table.insert(texts, {rightX, y, outputLabel:sub(1, math.max(0, available)), colors.white, colors.black})
end

function refreshDashboard()
	if not reactorLinkReady() then
		error(linkLost, 0)
	end
	local stats = readReactor()
	local bufferFraction = stats.rfTotal / rfTotalMax
	bufferPercent = bufferFraction * 100
	updateFuelGauge(stats)

	addOutputHistory(stats.rfPerTick)
	addNetFlow(stats.rfTotal, stats.rfPerTick)
	adjustRodsLevel(stats)
	stats.active = readPowerState()
	sampleSession(stats)
	if showingInfo or showingModes or targetEntry then
		if showingStats then showSessionStats() end
		resetDraw()
		sleep(2)
		return
	end
	addReading(1, "STORED  " .. format_num(stats.rfTotal, 0) .. " RF (" .. format_num(bufferFraction * 100, 1) .. "%)" .. (stats.rfTotal == 0 and " EMPTY" or ""), bufferFraction)
	addBufferMarkers()
	addReading(2, "ROD INSERTION  " .. stats.rodLevel .. "%", stats.rodLevel / 100)

	local x, y = numbersSize.inX, numbersSize.inY + 2
	table.insert(lines, {x, y, x + numbersSize.width, y, colors.black})
	table.insert(texts, {x, y, format_num(stats.fuelPerTick, 3) .. " mB/t", colors.white, colors.black})

	local efficiency = "EFF: --"
	if stats.fuelPerTick > 0 then
		efficiency = "EFF: " .. format_num(stats.rfPerTick / stats.fuelPerTick, 0) .. " RF/mB"
	end
	table.insert(lines, {x, y + 2, x + numbersSize.width, y + 2, colors.black})
	table.insert(texts, {x, y + 2, efficiency, colors.white, colors.black})

	if stats.wasteAmount ~= nil then
		local wasteColor = colors.white
		if stats.fuelCapacity and stats.fuelCapacity > 0 and stats.wasteAmount / stats.fuelCapacity >= 0.25 then
			wasteColor = colors.orange
		end
		table.insert(lines, {x, y + 6, x + numbersSize.width, y + 6, colors.black})
		table.insert(texts, {x, y + 6, "WASTE " .. format_num(stats.wasteAmount, 0) .. " mB", wasteColor, colors.black})
	end

	draw(stats)
	sleep(2)
end

--
-- Settings retain the existing MIN, MAX, optional RF/t line format.
function saveSettings()
	local handle = assert(fs.open(SETTINGS_FILE, "w"))
	handle.writeLine(tostring(minPowerRod))
	handle.writeLine(tostring(maxPowerRod))
	handle.writeLine(tostring(targetOutput))
	handle.writeLine(bootMode)
	handle.writeLine(soundEnabled and "SOUND ON" or "SOUND OFF")
	handle.writeLine(checkAtBoot and "UPDATE CHECK ON" or "UPDATE CHECK OFF")
	handle.close()
end

local function loadSettings()
	local handle = fs.open(SETTINGS_FILE, "r")
	if not handle then
		saveSettings()
		return
	end
	local minimum = tonumber((handle.readLine()))
	local maximum = tonumber((handle.readLine()))
	local setpoint = tonumber((handle.readLine()))
	local savedMode = handle.readLine()
	local savedSound = handle.readLine()
	local savedUpdateCheck = handle.readLine()
	handle.close()
	if minimum and maximum and minimum >= 0 and maximum <= 100 and minimum < maximum then
		minPowerRod, maxPowerRod = minimum, maximum
	end
	if setpoint and setpoint >= 50 and setpoint <= 1000000 then
		targetOutput = math.floor(setpoint)
	end
	soundEnabled = savedSound ~= "SOUND OFF"
	checkAtBoot = savedUpdateCheck == "UPDATE CHECK ON"
	for _, mode in ipairs(modeOptions) do
		if savedMode == mode then
			bootMode = mode
			controlMode = mode
			break
		end
	end
end

function format_num(value, precision)
	local formatted = string.format("%." .. precision .. "f", value)
	local sign, whole, decimal = formatted:match("^(-?)(%d+)(.*)$")
	local grouped = whole:reverse():gsub("(%d%d%d)", "%1,"):gsub(",$", "")
	return sign .. grouped:reverse() .. decimal
end
mon.setBackgroundColor(colors.black)
mon.clear()
mon.setTextScale(0.5)

loadSettings()
if checkAtBoot then checkForUpdate() end
playCue("ready")


local function runDashboard()
	buildDashboard()
	while true do
		parallel.waitForAny(refreshDashboard, clickEvent)
	end
end

-- Rebuild the dashboard after the original reactor port is usable again.
while true do
	local ok, reason = pcall(runDashboard)
	if ok then
		break
	end
	if reason == "Terminated" or (reason ~= linkLost and reactorLinkReady()) then
		error(reason, 0)
	end

	showingInfo = false
	showingUpdates = false
	showingStats = false
	confirmSessionReset = false
	session.last = nil
	showingModes = false
	choosingBootMode = false
	targetEntry = nil
	standbyArmed = false
	clearTable()
	resetDraw()
	playCue("warning")
	showStartup(mon, "REACTOR LINK LOST",
		"Controls paused. Check the reactor and wired modem.",
		"Waiting for the original port to return...")

	while true do
		sleep(2)
		local reactor = peripheral.wrap(reactorName)
		if reactor then
			reactors[1] = reactor
			if reactorLinkReady() and pcall(readReactor) then
				break
			end
		end
	end

	outputHistory = {}
	bufferSamples = {}
	netBufferRate = nil
	estimatedExport = nil
	fuelSamples = {}
	playCue("ready")
	mon.clear()
end
