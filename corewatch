local function paintDashboard(reactorActive)
	for _, rect in ipairs(filleds) do
		paintutils.drawFilledBox(rect[1], rect[2] + 1, rect[3], rect[4] + 1, rect[5])
	end
	for _, rect in ipairs(boxes) do
		paintutils.drawBox(table.unpack(rect))
	end
	for _, segment in ipairs(lines) do
		paintutils.drawLine(table.unpack(segment))
	end
	for _, item in ipairs(texts) do
		dashboard.setCursorPos(item[1], item[2])
		dashboard.setTextColor(item[4])
		dashboard.setBackgroundColor(item[5])
		dashboard.write(item[3])
	end
	renderControls(dashboard, reactorActive)
end

local function draw(sample)
	local reactorActive
	if sample then
		reactorActive = sample.active
	else
		reactorActive = readPowerState()
	end

	-- Compose into a hidden window and send only changed rows to the monitor.
	local previous = term.redirect(dashboard)
	local ok, reason = pcall(paintDashboard, reactorActive)
	term.redirect(previous)
	if not ok then error(reason, 0) end

	local _, height = dashboard.getSize()
	for y = 1, height do
		local characters, foreground, background = dashboard.getLine(y)
		local row = displayedRows[y]
		if not row or row[1] ~= characters or row[2] ~= foreground or row[3] ~= background then
			mon.setCursorPos(1, y)
			mon.blit(characters, foreground, background)
			displayedRows[y] = {characters, foreground, background}
		end
	end
	resetDraw()
end

