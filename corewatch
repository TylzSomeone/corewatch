local function runSteamController(record)
    local screen = record.screen
    local portName = record.port
    local timer
    local history, buttons = {}, {}
    local w, h = screen.getSize()
    local divider = math.floor(w * 2 / 3)
    local lx, rx, right = 4, divider + 3, w - 3
    local span = divider - lx - 2
    local graphBottom = math.floor(h * 0.48)
    local controlsBottom = math.floor(h * 0.63)
    local function rect(x1, y1, x2, y2, color)
        screen.setBackgroundColor(color)
        for row = y1, y2 do
            screen.setCursorPos(x1, row)
            screen.write(string.rep(" ", x2 - x1 + 1))
        end
        screen.setBackgroundColor(colors.black)
    end
    local function number(value, precision)
        local formatted = string.format("%." .. (precision or 0) .. "f", value or 0)
        local whole, tail = formatted:match("^(%d+)(.*)$")
        return whole and (whole:reverse():gsub("(%d%d%d)", "%1,"):gsub(",$", ""):reverse() .. tail) or formatted
    end
    local function frame(x1, y1, x2, y2, title, color)
        rect(x1, y1, x2, y1, colors.gray)
        rect(x1, y2, x2, y2, colors.gray)
        rect(x1, y1, x1, y2, colors.gray)
        rect(x2, y1, x2, y2, colors.gray)
        textAt(screen, x1 + 2, y1, " " .. title .. " ", color or colors.cyan)
    end
    local function button(id, title, x1, y1, x2, y2, color, selected, change)
        rect(x1, y1, x2, y2, color)
        if selected then rect(x1, y1, x1, y2, colors.lime) end
        screen.setBackgroundColor(color)
        textAt(screen, math.floor((x1 + x2 - #title + 1) / 2), math.floor((y1 + y2) / 2), title)
        screen.setBackgroundColor(colors.black)
        buttons[#buttons + 1] = {id = id, x1 = x1, y1 = y1, x2 = x2, y2 = y2, change = change}
    end
    local function gauge(label, contents, capacity, row, color)
        contents, capacity = contents or 0, capacity or 0
        local fraction = capacity > 0 and math.max(0, math.min(1, contents / capacity)) or 0
        local caption = label .. " " .. number(contents) .. " / " .. number(capacity) .. " mB"
        caption = caption .. (capacity > 0 and (" (" .. number(fraction * 100, 1) .. "%)") or " (--)")
        if contents == 0 then caption = caption .. " EMPTY" end
        textAt(screen, lx, row, caption:sub(1, span))
        rect(lx, row + 1, lx + span - 1, row + 3, colors.gray)
        local filled = math.floor(span * fraction)
        if filled > 0 then rect(lx, row + 1, lx + filled - 1, row + 3, color) end
    end
    local function graph(output, sample)
        local pixelWidth = span * 2
        local top, bottom = 6, graphBottom - 1
        local pixelHeight = (bottom - top + 1) * 3
        if sample then
            history[#history + 1] = output
            if #history > pixelWidth then table.remove(history, 1) end
        end
        local peak = 0
        for _, value in ipairs(history) do peak = math.max(peak, value) end
        textAt(screen, lx, 4, ("STEAM " .. number(output) .. " mB/t | PEAK " .. number(peak)):sub(1, span))
        rect(lx, top, lx + span - 1, bottom, colors.gray)
        local cells = {}
        local function plot(px, py)
            local cell = math.floor(py / 3) * span + math.floor(px / 2)
            cells[cell] = bit32.bor(cells[cell] or 0, 2 ^ ((py % 3) * 2 + px % 2))
        end
        local previous
        for i, value in ipairs(history) do
            local px = pixelWidth - #history + i - 1
            local py = pixelHeight - 1 - math.floor((pixelHeight - 1) * value / math.max(1, peak))
            if previous then
                local middle = math.floor((previous + py) / 2)
                for row = math.min(previous, middle), math.max(previous, middle) do plot(px - 1, row) end
                for row = math.min(middle, py), math.max(middle, py) do plot(px, row) end
            else plot(px, py) end
            previous = py
        end
        for cell, mask in pairs(cells) do
            local inverse = mask >= 32
            screen.setBackgroundColor(inverse and colors.lime or colors.gray)
            textAt(screen, lx + cell % span, top + math.floor(cell / span),
                string.char(128 + (inverse and 63 - mask or mask)), inverse and colors.gray or colors.lime)
        end
        screen.setBackgroundColor(colors.black)
    end
    local function refresh(sample)
        local device = assert(peripheral.wrap(portName), "Steam reactor link lost")
        assert(not device.mbIsAssembled or device.mbIsAssembled(), "Steam reactor not assembled")
        assert(device.isActivelyCooled(), "Cooling configuration changed")
        local fuel = device.getFuelStats()
        local steam = device.getHotFluidStats()
        local coolant = device.getCoolantFluidStats()
        local rods = device.getControlRodsLevels()
        local active = device.getActive()
        record.status = active and "RUNNING" or "OFF"
        record.output = steam.fluidProducedLastTick or 0
        record.unit = "mB/t"
        record.fuel = fuel.fuelCapacity > 0 and fuel.fuelAmount * 100 / fuel.fuelCapacity or 0
        screen.setBackgroundColor(colors.black)
        screen.clear()
        frame(2, 2, divider, h - 1, "STEAM REACTOR")
        frame(divider + 1, 2, w - 1, controlsBottom, active and "RUNNING" or "OFF", active and colors.cyan or colors.red)
        frame(divider + 1, controlsBottom + 2, w - 1, h - 1, "FUEL & HEAT")
        graph(record.output, sample)
        gauge("STEAM", steam.fluidAmount, steam.fluidCapacity, graphBottom + 2, colors.lime)
        gauge("COOLANT", coolant.fluidAmount, coolant.fluidCapacity, graphBottom + 7, colors.lightBlue)
        local rodLevel = rods[0] or 0
        textAt(screen, lx, h - 4, "ROD INSERTION " .. number(rodLevel) .. "%")
        rect(lx, h - 3, lx + span - 1, h - 3, colors.gray)
        local filled = math.floor(span * math.max(0, math.min(100, rodLevel)) / 100)
        if filled > 0 then rect(lx, h - 3, lx + filled - 1, h - 3, colors.lime) end
        buttons = {}
        local middle = math.floor((rx + right) / 2)
        button("ON", "ON", rx, 4, middle - 1, 6, colors.blue, active)
        button("OFF", "OFF", middle + 1, 4, right, 6, colors.blue, not active)
        textAt(screen, rx, 8, "MANUAL STEAM CONTROL", colors.cyan)
        textAt(screen, rx, 9, "Auto regulation: later", colors.lightGray)
        textAt(screen, rx, 11, "ROD INSERTION", colors.lightGray)
        textAt(screen, rx, 12, number(rodLevel) .. "%")
        button("RODS", "-10%", rx, 14, middle - 1, 16, colors.lightBlue, false, -10)
        button("RODS", "-1%", middle + 1, 14, right, 16, colors.purple, false, -1)
        button("RODS", "+10%", rx, 18, middle - 1, 20, colors.lightBlue, false, 10)
        button("RODS", "+1%", middle + 1, 18, right, 20, colors.purple, false, 1)
        local fuelRow = controlsBottom + 4
        local fuelColor = record.fuel < 5 and colors.red or record.fuel < 15 and colors.orange or colors.white
        textAt(screen, rx, fuelRow, "FUEL " .. number(record.fuel, 1) .. "%", fuelColor)
        textAt(screen, rx, fuelRow + 2, number(fuel.fuelConsumedLastTick, 3) .. " mB/t")
        local wasteColor = fuel.fuelCapacity > 0 and fuel.wasteAmount / fuel.fuelCapacity >= 0.25 and colors.orange or colors.white
        textAt(screen, rx, fuelRow + 4, "WASTE " .. number(fuel.wasteAmount) .. " mB", wasteColor)
        textAt(screen, rx, fuelRow + 6, "FUEL " .. number(fuel.fuelTemperature) .. " C", colors.lightGray)
        textAt(screen, rx, fuelRow + 8, "CASING " .. number(device.getCasingTemperature()) .. " C", colors.lightGray)
    end
    refresh(true)
    timer = os.startTimer(2)
    while true do
        local event, side, x, y = os.pullEvent()
        if event == "timer" and side == timer then
            refresh(true)
            timer = os.startTimer(2)
        elseif event == "monitor_touch" and side == displayName then
            local clicked
            for _, candidate in ipairs(buttons) do
                if x >= candidate.x1 and x <= candidate.x2 and y >= candidate.y1 and y <= candidate.y2 then clicked = candidate; break end
            end
            if clicked then
            local device = assert(peripheral.wrap(portName), "Steam reactor link lost")
            assert(device.isActivelyCooled(), "Cooling configuration changed")
            assert(not device.mbIsAssembled or device.mbIsAssembled(), "Steam reactor not assembled")
            if clicked.id == "ON" then device.setActive(true)
            elseif clicked.id == "OFF" then device.setActive(false)
            else
                local delta = clicked.change
                if delta then
                    -- Read current positions at the instant of the touch.
                    local current = device.getControlRodsLevels()
                    local requested = {}
                    for index, level in pairs(current) do requested[index] = math.max(0, math.min(100, level + delta)) end
                    device.setControlRodsLevels(requested)
                end
            end
            refresh(false)
            end
        end
    end
end

local function startWorker(record)
    if migration then return end
    local kind, status = classify(record.port)
    if not kind then
        record.status = status
        record.output = nil
        record.screen.setBackgroundColor(colors.black)
        record.screen.clear()
        textAt(record.screen, 3, 4, status, colors.red)
        textAt(record.screen, 3, 7, "Check the reactor assembly, computer port, and wired modem.", colors.white)
        textAt(record.screen, 3, 10, "Other reactors continue while this port is unavailable.", colors.lightGray)
        return
    end
    record.kind = kind
    record.unit = kind == "STEAM" and "mB/t" or "RF/t"
    record.terminal = nativeTerminal
    record.thread = coroutine.create(function()
        if record.phase > 0 then sleep(record.phase) end
        if kind == "STEAM" then return runSteamController(record) end
        runRFController(record.port, record.screen, displayName, settingsFor(record.port),
            function(state, output, fuel, mode)
                record.status, record.output, record.fuel, record.mode = state, output, fuel, mode
            end,
            function() return selected == record.port end,
            function(release)
                if release then
                    if updateOwner == record then updateOwner = nil end
                    return true
                end
                if updateOwner and updateOwner ~= record then return false end
                updateOwner = record
                return true
            end,
            function(release)
                if release then updateInstalled = false; return true end
                if updateInstalled then return false end
                updateInstalled = true
                return true
            end)
    end)
end

local function resumeWorker(record, event)
    if not record.thread then return end
    term.redirect(record.terminal or nativeTerminal)
    local ok, filter = coroutine.resume(record.thread, table.unpack(event, 1, event.n or #event))
    record.terminal = term.current()
    term.redirect(nativeTerminal)
    if not ok or coroutine.status(record.thread) == "dead" then
        record.thread = nil
        record.status = "CONTROLLER PAUSED"
        record.error = tostring(filter or "Controller stopped")
        record.output = nil
        if updateOwner == record then updateOwner = nil end
        record.screen.setBackgroundColor(colors.black)
        record.screen.clear()
        textAt(record.screen, 3, 4, "CONTROLLER PAUSED", colors.red)
        textAt(record.screen, 3, 7, record.error, colors.white)
        textAt(record.screen, 3, 10, "Other reactors continue. Checking this port again shortly.", colors.lightGray)
        print("[Corewatch] " .. record.port .. ": " .. record.error)
    else record.filter = filter end
end

local function alerts()
    local count = 0
    for _, record in ipairs(records) do
        if record.status == "LINK LOST" or record.status == "CONTROLLER PAUSED" or record.status == "NOT ASSEMBLED"
            or (record.fuel and record.fuel < 5) then count = count + 1 end
    end
    return count
end

local function render()
    term.redirect(nativeTerminal)
    view.setBackgroundColor(colors.black)
    view.clear()
    local count = alerts()
    textAt(view, 2, 1, overview and "COREWATCH  |  MACHINES" or "[ MACHINES ]", colors.cyan)
    local record = byPort[selected]
    if not overview and record then
        textAt(view, 17, 1, record.name .. "  |  " .. (record.kind or "CHECKING"), colors.cyan)
        textAt(view, width - 10, 1, "[ RENAME ]", colors.lightBlue)
        textAt(view, 2, 2, record.port .. (count > 0 and ("  |  ALERTS: " .. count) or ""), count > 0 and colors.orange or colors.lightGray)
        for y = 1, height - 2 do
            local chars, fg, bg = record.screen.getLine(y)
            view.setCursorPos(1, y + 2)
            view.blit(chars, fg, bg)
        end
    else
        local heading = migration and "Choose the ORIGINAL reactor to inherit your existing settings." or "Select a reactor. All registered controllers keep working."
        textAt(view, 2, 3, heading, migration and colors.orange or colors.lightGray)
        if pendingName then textAt(view, 2, 3, "Type a name at the CC computer, then press Enter: " .. pendingName, colors.cyan) end
        local perPage = math.max(1, math.floor((height - 8) / 4))
        local pages = math.max(1, math.ceil(#records / perPage))
        page = math.max(1, math.min(page, pages))
        for slot = 1, perPage do
            local entry = records[(page - 1) * perPage + slot]
            if entry then
                local y = 5 + (slot - 1) * 4
                textAt(view, 3, y, entry.name .. "  |  " .. (entry.kind or "CHECKING") .. "  |  " .. entry.status, colors.cyan)
                textAt(view, 3, y + 1, entry.port, colors.lightGray)
                if entry.output then
                    textAt(view, 3, y + 2, string.format("%.0f %s%s", entry.output, entry.unit, entry.mode and ("  |  " .. entry.mode) or ""))
                end
            end
        end
        if #records == 0 then textAt(view, 3, 6, "No reactor ports found. Check the wired modems.", colors.orange) end
        textAt(view, 3, height - 2, "[ PREV ]   " .. page .. "/" .. pages .. "   [ NEXT ]", colors.lightBlue)
        textAt(view, 3, height, "Reactors: " .. #records .. "   Alerts: " .. count .. "   Turbine control: coming later", colors.lightGray)
    end
    for y = 1, height do
        local chars, fg, bg = view.getLine(y)
        local row = displayed[y]
        if not row or row[1] ~= chars or row[2] ~= fg or row[3] ~= bg then
            physical.setCursorPos(1, y)
            physical.blit(chars, fg, bg)
            displayed[y] = {chars, fg, bg}
        end
    end
end

local function launchPending()
    for _, record in ipairs(records) do
        if not record.thread then
            startWorker(record)
            if record.thread then resumeWorker(record, {n = 0}) end
        end
    end
end

-- Initialize once. Subsequent starts are staggered by the maintenance timer.
launchPending()
render()
local maintenance = os.startTimer(2)
while true do
    local event = table.pack(os.pullEventRaw())
    local name, side, x, y = table.unpack(event)
    if name == "terminate" then
        -- Deliver termination to every controller so none remains armed in memory.
        for _, record in ipairs(records) do if record.thread then resumeWorker(record, event) end end
        term.redirect(nativeTerminal)
        error("Terminated", 0)
    end
    local consumed = false
    if name == "monitor_resize" and side == displayName then
        error("Monitor size changed. Reboot the CC computer to rebuild the display.", 0)
    elseif name == "monitor_touch" and side == displayName then
        if y <= 2 then
            consumed = true
            if x <= 14 then overview = true
            elseif not overview and x >= width - 10 then
                pendingName = ""
                overview = true
                print("[Corewatch] Type the new reactor name, then press Enter. Escape cancels.")
            end
        elseif overview then
            consumed = true
            local perPage = math.max(1, math.floor((height - 8) / 4))
            if y >= height - 2 then
                if x <= 11 then page = page - 1 else page = page + 1 end
            elseif y >= 5 and y < 5 + perPage * 4 and not pendingName then
                local index = (page - 1) * perPage + math.floor((y - 5) / 4) + 1
                if records[index] then
                    selected = records[index].port
                    if migration then
                        registry.primary = selected
                        migration = false
                        saveRegistry()
                        launchPending()
                    end
                    overview = false
                    saveRegistry()
                end
            end
        end
    elseif pendingName and name == "char" then
        pendingName = (pendingName .. side):sub(1, 28)
        consumed = true
    elseif pendingName and name == "paste" then
        pendingName = (pendingName .. side:gsub("[%c]", "")):sub(1, 28)
        consumed = true
    elseif pendingName and name == "key" then
        consumed = true
        if side == keys.backspace then pendingName = pendingName:sub(1, -2)
        elseif side == keys.escape then pendingName = nil; overview = false
        elseif side == keys.enter and pendingName:match("%S") then
            local record = byPort[selected]
            record.name = pendingName
            registry.machines[selected].name = pendingName
            pendingName = nil
            overview = false
            saveRegistry()
        end
    end
    if name == "timer" and side == maintenance then
        scan()
        launchPending()
        maintenance = os.startTimer(2)
    end
    local owner = updateOwner
    if (name == "http_success" or name == "http_failure") and owner then updateOwner = nil end
    for _, record in ipairs(records) do
        local deliver = not consumed and (not record.filter or record.filter == name)
        if name == "monitor_touch" then
            deliver = deliver and side == displayName and not overview and selected == record.port
        elseif name == "http_success" or name == "http_failure" then deliver = deliver and owner == record end
        if deliver and record.thread then
            local forwarded = event
            if name == "monitor_touch" then forwarded = table.pack(name, side, x, y - 2) end
            resumeWorker(record, forwarded)
        end
    end
    render()
end
