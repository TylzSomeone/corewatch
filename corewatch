function fill(color, buttonData, accent, display)
	display = display or mon
	local x = math.floor(buttonData.xmin)
	local width = math.floor(buttonData.xmax) - x + 1
	local top = math.ceil(buttonData.ymin)
	local bottom = math.floor(buttonData.ymax)
	local middle = math.floor((top + bottom) / 2)
	local title = buttonData.title:sub(1, width)
	local padding = math.floor((width - #title) / 2)

	local blank = string.rep(" ", width)
	local label = string.rep(" ", padding) .. title .. string.rep(" ", width - padding - #title)
	local foreground = string.rep(colors.toBlit(colors.white), width)
	local background = string.rep(colors.toBlit(color), width)
	if accent then
		background = colors.toBlit(accent) .. background:sub(2)
	end

	for row = top, bottom do
		display.setCursorPos(x, row)
		display.blit(row == middle and label or blank, foreground, background)
	end
end


local fuelSamples = {}
local fuelPercent
local fuelMinutesLeft

local function updateFuelGauge(stats)
   if not stats.fuelCapacity or stats.fuelCapacity <= 0 or not stats.fuelAmount then
      fuelPercent, fuelMinutesLeft = nil, nil
      return
   end

   fuelPercent = math.floor(100 * stats.fuelAmount / stats.fuelCapacity + 0.5)
   checkFuelWarning(fuelPercent)
   local now = os.clock()
   fuelSamples[#fuelSamples + 1] = {time = now, burn = stats.fuelPerTick}
   while fuelSamples[1].time <= now - 60 do
      table.remove(fuelSamples, 1)
   end

   local totalBurn = 0
   for _, sample in ipairs(fuelSamples) do
      totalBurn = totalBurn + sample.burn
   end

   fuelMinutesLeft = nil
   if totalBurn > 0 then
      local burnPerTick = totalBurn / #fuelSamples
      fuelMinutesLeft = stats.fuelAmount / (burnPerTick * 20 * 60)
   end
end

