local function showStartup(monitor, message, detail, hint, progress)
	monitor.setTextScale(0.5)
	monitor.setBackgroundColor(colors.black)
	monitor.clear()
	local width, height = monitor.getSize()
	local middle = math.floor(height / 2)

	local function center(row, text, color)
		monitor.setTextColor(color)
		monitor.setCursorPos(math.max(1, math.floor((width - #text) / 2) + 1), row)
		monitor.write(text:sub(1, width))
	end

	center(middle - 6, "C O R E W A T C H", colors.cyan)
	center(middle - 4, "v" .. COREWATCH_VERSION, colors.lightGray)
	center(middle, message, progress and colors.white or colors.red)
	if progress then
		local barWidth = math.min(30, width - 2)
		local filled = math.floor(barWidth * progress)
		center(middle + 2, "[" .. string.rep("#", filled) .. string.rep("-", barWidth - filled) .. "]", colors.lime)
	end
	center(middle + 4, detail, colors.lightGray)
	center(middle + 6, hint, colors.lightGray)
end

