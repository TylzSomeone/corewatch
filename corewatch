local function renderControls(mon, reactorActive)
   local status = "REACTOR UNKNOWN"
   local statusColor = colors.lightGray
   if reactorActive ~= nil then
      status = reactorActive and "REACTOR RUNNING" or "REACTOR OFF"
      statusColor = reactorActive and colors.lime or colors.red
   end
   if controlMode == "STANDBY" and reactorActive ~= nil then
      if not standbyArmed then
         status, statusColor = "STANDBY DISARMED", colors.lightGray
      elseif reactorActive then
         status, statusColor = "STANDBY RUNNING", colors.lime
      else
         status, statusColor = "STANDBY ARMED", colors.cyan
      end
   end
   mon.setCursorPos(controlsSize.inX, controlsSize.startY)
   mon.setBackgroundColor(colors.black)
   mon.setTextColor(statusColor)
   mon.write(status .. string.rep(" ", #"STANDBY DISARMED" - #status))

   local throttle = "STATE UNAVAILABLE"
   if controlMode == "STANDBY" and reactorActive ~= nil then
      if not standbyArmed then
         throttle = "AUTO START DISABLED"
      elseif reactorActive then
         throttle = "RUNNING UNTIL MAX"
      else
         if bufferPercent <= minPowerRod then
            throttle = "STARTING AT MIN"
         elseif not netBufferRate then
            throttle = "MEASURING BUFFER"
         elseif netBufferRate >= 0.5 then
            throttle = "BUFFER FILLING"
         elseif netBufferRate > -0.5 then
            throttle = "BUFFER STEADY"
         else
            local remainingRF = (bufferPercent - minPowerRod) * rfTotalMax / 100
            local seconds = remainingRF / (-netBufferRate * 20)
            if seconds < 60 then
               throttle = "START IN ~" .. math.ceil(seconds) .. "s"
            elseif seconds < 3600 then
               throttle = "START IN ~" .. math.ceil(seconds / 60) .. "m"
            elseif seconds < 86400 then
               throttle = "START IN ~" .. math.ceil(seconds / 3600) .. "h"
            else
               throttle = "START IN ~" .. math.ceil(seconds / 86400) .. "d"
            end
         end
      end
   elseif reactorActive == false then
      throttle = "OUTPUT DISABLED"
   elseif reactorActive and controlMode == "MANUAL" then
      throttle = "MANUAL ROD CONTROL"
   elseif reactorActive then
      if bufferPercent >= maxPowerRod then
         throttle = "BUFFER AT TARGET"
      elseif controlMode == "TARGET RF/t" then
         throttle = "TRACKING RF TARGET"
      elseif controlMode == "LOAD MATCH" then
         if netBufferRate == nil then
            throttle = "MEASURING BUFFER"
         elseif bufferPercent < minPowerRod then
            throttle = "BUILDING RESERVE"
         else
            throttle = "MATCHING BASE LOAD"
         end
      elseif bufferPercent <= minPowerRod then
         throttle = "FULL OUTPUT REQUEST"
      else
         throttle = "THROTTLING OUTPUT"
      end
   end
   mon.setCursorPos(controlsSize.inX, controlsSize.inY + 4)
   mon.setTextColor(colors.lightGray)
   mon.write(throttle .. string.rep(" ", math.max(0, #"FULL OUTPUT REQUEST" - #throttle)))

   local fuelLabel = fuelPercent and ("FUEL " .. fuelPercent .. "%") or "FUEL --%"
   if reactorActive and fuelMinutesLeft then
      if fuelMinutesLeft < 1 then
         fuelLabel = fuelLabel .. " <1m left"
      elseif fuelMinutesLeft < 60 then
         fuelLabel = fuelLabel .. " ~" .. math.floor(fuelMinutesLeft) .. "m left"
      elseif fuelMinutesLeft < 1440 then
         fuelLabel = fuelLabel .. " ~" .. math.floor(fuelMinutesLeft / 60) .. "h left"
      else
         fuelLabel = fuelLabel .. " ~" .. math.floor(fuelMinutesLeft / 1440) .. "d left"
      end
   elseif reactorActive and fuelPercent then
      fuelLabel = fuelLabel .. " (idle)"
   end
   mon.setCursorPos(numbersSize.inX, numbersSize.inY + 6)
   local fuelColor = colors.white
   if fuelPercent and fuelPercent < 5 then
      fuelColor = colors.red
   elseif fuelPercent and fuelPercent < 15 then
      fuelColor = colors.orange
   end
   mon.setTextColor(fuelColor)
   mon.write(fuelLabel .. string.rep(" ", math.max(0, math.floor(numbersSize.width) + 1 - #fuelLabel)))

   local x = math.floor(controlsSize.inX)
   local y = button["low-10"].ymin - 3
   local width = math.floor(controlsSize.endX) - x
   mon.setBackgroundColor(colors.black)
   for row = y, y + 1 do
      mon.setCursorPos(x, row)
      mon.write(string.rep(" ", width))
   end
   if controlMode == "MANUAL" then
      mon.setCursorPos(x, y)
      mon.setTextColor(colors.lightGray)
      mon.write("ADJUST ROD INSERTION")
   else
      local leftLabel = math.floor((button["low-10"].xmin + button["low-10"].xmax - 2) / 2)
      local rightLabel = math.floor((button["high-10"].xmin + button["high-10"].xmax - 2) / 2)
      mon.setTextColor(colors.lightBlue)
      mon.setCursorPos(leftLabel, y)
      mon.write(controlMode == "TARGET RF/t" and "SET RF/t" or "MIN")
      local left = button["low-10"]
      local right = button["high-10"]
      local leftValue = controlMode == "TARGET RF/t" and tostring(targetOutput) or minPowerRod .. "%"
      fill(colors.lightBlue, {xmin = left.xmin, xmax = left.xmax, ymin = y + 1, ymax = y + 1, title = leftValue}, nil, mon)
      mon.setTextColor(colors.purple)
      mon.setCursorPos(rightLabel, y)
      mon.write("MAX")
      fill(colors.purple, {xmin = right.xmin, xmax = right.xmax, ymin = y + 1, ymax = y + 1, title = maxPowerRod .. "%"}, nil, mon)
   end

   button.ON.title = controlMode == "STANDBY" and "ARM" or "ON"
   button.OFF.title = controlMode == "STANDBY" and "DISARM" or "OFF"
   button.MODE.title = "MODE: " .. controlMode
   button["low-10"].title = controlMode == "TARGET RF/t" and "-50 RF/t" or "-10%"
   button["low+10"].title = controlMode == "TARGET RF/t" and "+50 RF/t" or "+10%"
   button["high-10"].title = controlMode == "MANUAL" and "-1%" or "-10%"
   button["high+10"].title = controlMode == "MANUAL" and "+1%" or "+10%"
   for name, data in pairs(button) do
      local color = data["color"]
      local accent
      if name == "INFO" then
         data.title = downloadedUpdate and "UPDATE" or "INFO"
         if downloadedUpdate then color = colors.green end
      elseif name == "ON" or name == "OFF" then
         color = colors.gray
         local selectedState = reactorActive
         if controlMode == "STANDBY" then selectedState = standbyArmed end
         if selectedState ~= nil and (name == "ON") == selectedState then
            accent = colors.lime
         end
      end
      fill(color, data, accent, mon)
   end
end


