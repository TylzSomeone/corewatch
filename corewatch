local function showTargetPad()
	local current, low, high, unit = entryLimits()
	mon.setBackgroundColor(colors.black)
	mon.clear()
	local width = mon.getSize()
	mon.setCursorPos(3, 2)
	mon.setTextColor(colors.cyan)
