local function newerVersion(candidate, installed)
	local a, b, c = candidate:match("^(%d+)%.(%d+)%.(%d+)$")
	local x, y, z = installed:match("^(%d+)%.(%d+)%.(%d+)$")
	if not a or not x then return false end
	a, b, c, x, y, z = tonumber(a), tonumber(b), tonumber(c), tonumber(x), tonumber(y), tonumber(z)
	if a ~= x then return a > x end
	if b ~= y then return b > y end
	return c > z
end

local function checkForUpdate()
	if updatePending or updateInstalled then return end
	downloadedUpdate = nil
	if not http or not http.request then
		updateStatus = "HTTP is disabled on this server."
		return
	end
	local ok, queued = pcall(http.request, {
		url = UPDATE_URL, headers = {["Cache-Control"] = "no-cache"},
	})
	updatePending = ok and queued == true
	updateStatus = updatePending and "Checking GitHub..." or "Could not start the GitHub request."
end

local function finishUpdateCheck(response)
	updatePending = false
	local ok, source = pcall(response.readAll)
	response.close()
	local version = ok and type(source) == "string"
		and source:match('local COREWATCH_VERSION = "(%d+%.%d+%.%d+)"')
	if not version or not source:match("^%-%- Corewatch |") or not load(source, "@corewatch-update", "t") then
		updateStatus = "The download was not a valid Corewatch program."
	elseif newerVersion(version, COREWATCH_VERSION) then
		downloadedUpdate = source
		updateStatus = "UPDATE AVAILABLE: v" .. version
	elseif version == COREWATCH_VERSION then
		updateStatus = "You are on the published version."
	else
		updateStatus = "This copy is newer than the published version."
	end
end

local function installUpdate()
	if not downloadedUpdate or updateInstalled then return end
	local staged, backup = programPath .. ".download", programPath .. ".previous"
	local ok, reason = pcall(function()
		local file = assert(fs.open(staged, "w"))
		file.write(downloadedUpdate)
		file.close()
		local check = assert(fs.open(staged, "r"))
		local contents = check.readAll()
		check.close()
		assert(contents == downloadedUpdate, "download verification failed")
		if fs.exists(backup) then fs.delete(backup) end
		fs.move(programPath, backup)
		local moved, moveError = pcall(fs.move, staged, programPath)
		if not moved then
			fs.move(backup, programPath)
			error(moveError, 0)
		end
	end)
	if ok then
		updateInstalled = true
		downloadedUpdate = nil
		updateStatus = "Installed. Press Ctrl+R when ready to reboot."
	else
		updateStatus = "Install failed. See the computer terminal."
		print("[Corewatch] Update failed: " .. tostring(reason))
	end
end

local SPLASH_DURATION = 4
