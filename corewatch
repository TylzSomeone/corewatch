	line(5, "ESTIMATES SINCE COREWATCH STARTED", colors.lightGray)

	local function efficiency(totals)
		return totals.fuel > 0 and (format_num(totals.energy / totals.fuel, 0) .. " RF/mB") or "--"
	end

	local function running(totals)
		if not totals.powerSeconds or totals.powerSeconds == 0 then return "--" end
		local duty = totals.runningSeconds * 100 / totals.powerSeconds
		return format_num(totals.runningSeconds / 60, 1) .. " min on   |   Duty " .. format_num(duty, 1) .. "%"
	end

	if statsByMode then
		for i, mode in ipairs(modeOptions) do
			local y = 7 + (i - 1) * 4
			local totals = session.modes[mode]
			line(y, mode, colors.cyan)
