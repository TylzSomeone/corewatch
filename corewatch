local function setButton(id, title, callback, left, top, right, bottom, arg, amount, color)
	button[id] = {
		title = title, func = callback, xmin = math.floor(left), ymin = math.ceil(top),
		xmax = math.floor(right), ymax = math.floor(bottom), elem = arg, elem2 = amount, color = color,
