	mon.setCursorPos(3, 5)
	mon.setTextColor(colors.lightGray)
	mon.write("Enter " .. low .. " to " .. high .. unit .. ".")
	targetKeys = {}
	local function key(label, x, y, span, color)
		local item = {xmin = x, xmax = x + span - 1, ymin = y, ymax = y + 2, title = label}
		targetKeys[#targetKeys + 1] = item
		fill(color, item)
	end
	local left = math.floor((width - 34) / 2) + 1
	local labels = {"1", "2", "3", "4", "5", "6", "7", "8", "9", "CLEAR", "0", "DEL"}
	for i, label in ipairs(labels) do
		local column, row = (i - 1) % 3, math.floor((i - 1) / 3)
		key(label, left + column * 12, 7 + row * 4, 10, colors.gray)
	end
	local value = tonumber(targetEntry)
	key("CANCEL", left, 24, 16, colors.gray)
	key("APPLY", left + 18, 24, 16, value and value >= low and value <= high and colors.green or colors.gray)
end

local function handleTargetKey(x, y)
	for _, key in ipairs(targetKeys) do
		if x >= key.xmin and x <= key.xmax and y >= key.ymin and y <= key.ymax then
			local label = key.title
			if label == "CANCEL" then
				playCue("tap")
				return true
			end
			if label == "APPLY" then
				local value = tonumber(targetEntry)
				local _, low, high = entryLimits()
				if value and value >= low and value <= high then
					if entryField == "MIN" then
						minPowerRod = value
					elseif entryField == "MAX" then
						maxPowerRod = value
					else
						targetOutput = value
					end
					saveSettings()
					playCue("tap")
					return true
				end
				return false
			end
			if label == "CLEAR" then
				targetEntry = ""
			elseif label == "DEL" then
				targetEntry = targetEntry:sub(1, -2)
			elseif #targetEntry < 7 then
				targetEntry = targetEntry .. label
			end
			playCue("tap")
			showTargetPad()
			return false
		end
	end
end

function clickEvent()
	local powerCheck
	while true do
		local event, side, x, y = os.pullEvent()
		if event == "http_success" and side == UPDATE_URL and updatePending then
			finishUpdateCheck(x)
			if showingUpdates then showUpdates()
			elseif showingInfo and not showingStats then showInfo(infoPage) end
		elseif event == "http_failure" and side == UPDATE_URL and updatePending then
			updatePending = false
			if y then y.close() end
			updateStatus = "GitHub check failed. Try again later."
			if showingUpdates then showUpdates() end
		elseif event == "timer" and side == powerCheck then
			powerCheck = nil
			if not showingInfo and not showingModes and not targetEntry then draw() end
		elseif event == "monitor_touch" and side == screenName then
			if targetEntry then
				if handleTargetKey(x, y) then
					targetEntry = nil
					mon.clear()
					buildDashboard()
					draw()
				end
			elseif showingModes then
				local width = mon.getSize()
				local selected
				if x >= 3 and x <= 18 and y >= 5 and (y - 5) % 5 <= 2 then
					selected = modeOptions[math.floor((y - 5) / 5) + 1]
				end
				local back = x >= width - 10 and x <= width - 1 and y <= 3
				if choosingBootMode then
					if selected then
						bootMode = selected
						saveSettings()
					end
					if selected or back then
						playCue("tap")
						choosingBootMode = false
						showModeMenu()
					end
				elseif x >= width - 40 and x <= width - 28 and y <= 3 then
					soundEnabled = not soundEnabled
					saveSettings()
					playCue("tap")
					showModeMenu()
				elseif x >= width - 25 and x <= width - 13 and y <= 3 then
					playCue("tap")
					choosingBootMode = true
					showModeMenu()
				elseif selected or back then
					playCue("tap")
					showingModes = false
					if selected and selected ~= controlMode then
						controlMode = selected
						standbyArmed = selected == "STANDBY"
					end
					mon.clear()
					buildDashboard()
					draw()
				end
			elseif showingInfo then
				local width, height = mon.getSize()
				if showingUpdates then
					if x >= width - 10 and x <= width - 1 and y <= 3 then
						showingUpdates = false
						showInfo(infoPage)
					elseif y >= 10 and y <= 12 and x >= 3 and x <= 16 then
						checkForUpdate()
						showUpdates()
					elseif y >= 10 and y <= 12 and x >= 19 and x <= 32 and downloadedUpdate then
						installUpdate()
						showUpdates()
					elseif y >= 15 and y <= 17 and x >= 3 and x <= 24 then
						checkAtBoot = not checkAtBoot
						saveSettings()
						showUpdates()
					end
				elseif showingStats then
					local footer = y >= height - 3 and y <= height - 1
					local resetButton = footer and x >= width - 18 and x <= width - 2
					if confirmSessionReset then
						if resetButton then
							playCue("tap")
							session = {energy = 0, fuel = 0, seconds = 0, modes = {}}
							confirmSessionReset = false
							showSessionStats()
						elseif footer and x >= 3 and x <= 17 then
							confirmSessionReset = false
							showSessionStats()
						end
					elseif resetButton then
						playCue("tap")
						confirmSessionReset = true
						showSessionStats()
					elseif x >= width - 10 and x <= width - 1 and y <= 3 then
						showingStats = false
						playCue("tap")
						showInfo(infoPage)
					elseif x >= width - 24 and x <= width - 13 and y <= 3 then
						playCue("tap")
						statsByMode = not statsByMode
						showSessionStats()
					end
				elseif x >= width - 16 and x <= width - 2 and y >= height - 3 and y <= height - 1 then
					playCue("tap")
					showInfo(infoPage % 3 + 1)
				elseif x >= width - 39 and x <= width - 25 and y <= 3 then
					showUpdates()
				elseif x >= width - 22 and x <= width - 13 and y <= 3 then
					playCue("tap")
					statsByMode = false
					showSessionStats()
				elseif x >= width - 10 and x <= width - 1 and y <= 3 then
					playCue("tap")
					showingInfo = false
					mon.clear()
					buildDashboard()
					draw()
				end
