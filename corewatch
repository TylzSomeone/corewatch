local reactorTypes = {
	{"BigReactors-Reactor", "BIG"},
	{"bigger-reactor", "BIGGERv1"},
	{"BiggerReactors_Reactor", "BIGGERv2"},
}

local function discoverReactor()
	for _, entry in ipairs(reactorTypes) do
		local device = peripheral.find(entry[1])
		if device then
			local api = entry[2]
			if api == "BIG" and device.mbIsConnected and device.mbIsAssembled then
				api = "EXTREME"
			end
			if device.getEnergyStats then
				local ok, energy = pcall(device.getEnergyStats)
				if ok and energy.energyCapacity then rfTotalMax = energy.energyCapacity end
			elseif api == "BIGGERv2" then
				rfTotalMax = device.battery().capacity()
			end
			return device, api
		end
	end
end
