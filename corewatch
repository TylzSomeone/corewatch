local function settingsFor(port)
    if registry.primary == port then return "corewatch-settings.txt" end
    -- Hex encoding is reversible and cannot collide or create nested paths.
    return "corewatch-reactor-" .. (port:gsub(".", function(c) return string.format("%02x", c:byte()) end)) .. ".txt"
end

local function classify(port)
    local device = peripheral.wrap(port)
    if not device then return nil, "LINK LOST" end
    if device.mbIsAssembled then
        local ok, assembled = pcall(device.mbIsAssembled)
        if not ok or not assembled then return nil, "NOT ASSEMBLED" end
    end
    if device.isActivelyCooled then
        local ok, steam = pcall(device.isActivelyCooled)
        if not ok or type(steam) ~= "boolean" then return nil, "CHECK PORT" end
        return steam and "STEAM" or "RF"
    end
    -- Legacy adapters retain their existing RF support.
    return "RF"
end

local function scan()
    local names = peripheral.getNames()
    local listed = {}
    for _, port in ipairs(names) do listed[port] = true end
    for port in pairs(registry.machines) do
        if not listed[port] then names[#names + 1] = port end
    end
    table.sort(names)
    for _, port in ipairs(names) do
        local supported = registry.machines[port] ~= nil
        for _, kind in ipairs(knownTypes) do
            if peripheral.hasType(port, kind) then supported = true; break end
        end
        if supported and not byPort[port] then
            local saved = registry.machines[port]
            if not saved then
                saved = {name = "Reactor " .. (#records + 1)}
                registry.machines[port] = saved
            end
            local frame = window.create(physical, 1, 3, width, height - 2, false)
            -- Existing drawing code sees a monitor, while writes stay in memory.
            frame.setTextScale = function() end
            frame.isColor = physical.isColor
            frame.isColour = physical.isColour or physical.isColor
            local record = {port = port, name = saved.name, screen = frame, status = "CONNECTING"}
            record.phase = (#records * 0.07) % 2
            records[#records + 1], byPort[port] = record, record
            if not selected then selected = port end
        end
    end
    if not registry.primary then
        migration = fs.exists("corewatch-settings.txt") and #records > 1
        if #records == 1 or (#records > 0 and not migration) then
            registry.primary = records[1].port
            saveRegistry()
        end
    end
end

